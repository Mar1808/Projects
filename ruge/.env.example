APP_DB_PROFILE=centralized

# Supabase (centralized profile)
CENTRALIZED_DB_URL=jdbc:postgresql://aws-1-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
CENTRALIZED_DB_USERNAME=postgres.your_project_ref
CENTRALIZED_DB_PASSWORD=your_supabase_db_password

# Local profile (optional)
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=ruge
LOCAL_DB_USERNAME=ruge
LOCAL_DB_PASSWORD=ruge

GITLAB_CLIENT_ID=your_gitlab_client_id
GITLAB_CLIENT_SECRET=your_gitlab_client_secret
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_CLI_FORWARD_TO=http://app-ruge:8080/stripe/webhook
